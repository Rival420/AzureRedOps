# Copy to .env and adjust before running `docker compose up`.

# --- Web ---
WEB_PORT=8080

# --- Postgres ---
POSTGRES_USER=azureredops
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=azureredops

# --- Backend security ---
# Used to sign GUI session JWTs. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional dedicated Fernet key for token-vault encryption at rest.
# Generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY.
VAULT_KEY=

# --- Initial admin account (created on first start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-too

# GUI session lifetime (minutes)
ACCESS_TOKEN_MINUTES=720

# CORS (the SPA is same-origin via nginx, so "*" is fine for self-hosting)
CORS_ORIGINS=*
